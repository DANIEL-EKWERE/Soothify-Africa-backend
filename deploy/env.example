# /etc/soothify/env  --  read by all three services.
# Owned by root, chmod 600: it holds every secret the API has.

DEPLOY_TARGET=aws
DJANGO_SETTINGS_MODULE=soothifyAfrica.settings
API_URL=https://api.soothifyafrica.com.ng

# --- database (RDS, or Postgres on this box) ---
DB_NAME=soothify
DB_USER=soothify
DB_PASSWORD=
DB_HOST=
DB_PORT=5432

# --- background work ---
CELERY_BROKER_URL=redis://127.0.0.1:6379/0
CELERY_RESULT_BACKEND=redis://127.0.0.1:6379/1

# --- media and recordings (S3 or Cloudflare R2) ---
AWS_STORAGE_BUCKET_NAME=
AWS_S3_REGION_NAME=eu-west-1
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
# R2 only; leave unset for S3
# AWS_S3_ENDPOINT_URL=https://<account>.r2.cloudflarestorage.com

# --- payments ---
BACHS_SECRET_KEY=
BACHS_WEBHOOK_SECRET=

# --- calls ---
ZEGO_APP_ID=180281881
ZEGO_SERVER_SECRET=

# --- transcription ---
TRANSCRIBE_LANGUAGE=en-NG
