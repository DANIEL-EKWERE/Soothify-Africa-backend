# /etc/soothify/env  --  read by all three services.
# Owned by root, chmod 600: it holds every secret the API has.

DEPLOY_TARGET=cpanel
aws
DJANGO_SETTINGS_MODULE=soothifyAfrica.settings
API_URL=https://api.soothifyafrica.com.ng

# --- database (RDS, or Postgres on this box) ---
DB_NAME=soothify
DB_USER=soothify
DB_PASSWORD=
DB_HOST=
DB_PORT=5432

# --- background work ---
CELERY_BROKER_URL=redis://127.0.0.1:6379/0
CELERY_RESULT_BACKEND=redis://127.0.0.1:6379/1

# --- media and recordings (S3 or Cloudflare R2) ---
AWS_STORAGE_BUCKET_NAME=
AWS_S3_REGION_NAME=eu-west-1
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
# R2 only; leave unset for S3
# AWS_S3_ENDPOINT_URL=https://<account>.r2.cloudflarestorage.com

# --- payments ---
BACHS_SECRET_KEY=
BACHS_WEBHOOK_SECRET=
# How memberships are sold. "one_off" buys one period at a time and renews
# by reminder; "subscription" lets Bachs run the cycle. One-off while they
# refuse recurring charges in naira (NGN_SUBSCRIPTIONS_NOT_ENABLED) -- the
# day that is lifted, this is the only line that changes.
MEMBERSHIP_BILLING=one_off
# Whether the free week asks for a card first, and what is taken to prove
# it (refunded straight away). Bachs have no zero-amount card check and
# their smallest naira charge is 100, so that is the figure. Set
# TRIAL_REQUIRES_CARD=0 to give the week away on an email address alone.
TRIAL_REQUIRES_CARD=1
TRIAL_CARD_CHECK_NAIRA=100
# Whether we charge the saved card ourselves when a period ends, instead of
# only reminding the member to pay. Banks here usually want an OTP, which a
# background charge cannot ask for, so expect a good share to be refused --
# those fall back to the reminder. Set to 0 to only ever remind.
MEMBERSHIP_AUTO_CHARGE=1
MEMBERSHIP_CHARGE_GRACE_HOURS=48

# --- calls ---
ZEGO_APP_ID=180281881
ZEGO_SERVER_SECRET=

# --- transcription ---
TRANSCRIBE_LANGUAGE=en-NG
